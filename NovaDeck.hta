<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>NOVA DECK</title>

<hta:application
  id="novaDeckApp"
  applicationname="NovaDeck"
  border="none"
  caption="no"
  showintaskbar="yes"
  singleinstance="yes"
  scroll="no"
  innerborder="no"
  navigable="no"
  windowstate="normal" />

<style type="text/css">
/* ============================================================
   NOVA DECK  -  futuristisches Desktop-Cockpit
   ============================================================ */
* { margin:0; padding:0; box-sizing:border-box; }

html, body {
  width:100%; height:100%; overflow:hidden;
  background:#04060c; color:#c8e4f2;
  font-family:"Segoe UI","Trebuchet MS",Tahoma,sans-serif;
  font-size:13px; cursor:default;
  -ms-user-select:none;
}
input, textarea { -ms-user-select:text; }

/* ---------- Hintergrund ---------- */
#bg {
  position:absolute; left:0; top:0; right:0; bottom:0; z-index:0;
  background:
    radial-gradient(circle at 12% 8%,  rgba(0,170,255,.20), rgba(0,0,0,0) 48%),
    radial-gradient(circle at 88% 92%, rgba(255,0,170,.15), rgba(0,0,0,0) 46%),
    radial-gradient(circle at 60% 40%, rgba(0,255,210,.07), rgba(0,0,0,0) 55%),
    #04060c;
}
#grid {
  position:absolute; left:0; top:0; right:0; bottom:0; z-index:1; opacity:.55;
  background-image:
    repeating-linear-gradient(0deg,  rgba(52,230,255,.055) 0px, rgba(52,230,255,.055) 1px, rgba(0,0,0,0) 1px, rgba(0,0,0,0) 46px),
    repeating-linear-gradient(90deg, rgba(52,230,255,.055) 0px, rgba(52,230,255,.055) 1px, rgba(0,0,0,0) 1px, rgba(0,0,0,0) 46px);
}
#vign {
  position:absolute; left:0; top:0; right:0; bottom:0; z-index:2;
  background:radial-gradient(ellipse at 50% 50%, rgba(0,0,0,0) 45%, rgba(0,0,0,.72) 100%);
}
#scan {
  position:absolute; left:0; right:0; top:-12%; height:150px; z-index:3; opacity:.22;
  background:linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(52,230,255,.16) 45%, rgba(52,230,255,.30) 50%, rgba(52,230,255,.16) 55%, rgba(0,0,0,0) 100%);
  animation:scanmove 7.5s linear infinite;
}
@keyframes scanmove { 0% { top:-12%; } 100% { top:110%; } }

/* ---------- Grundgerüst ---------- */
#app { position:absolute; left:0; top:0; right:0; bottom:0; z-index:5; }

/* ---------- Titelleiste ---------- */
#titlebar {
  position:absolute; left:0; top:0; right:0; height:50px;
  border-bottom:1px solid rgba(52,230,255,.18);
  background:linear-gradient(180deg, rgba(8,18,32,.92) 0%, rgba(6,12,22,.55) 100%);
  cursor:move;
}
.brand {
  position:absolute; left:18px; top:12px;
  font-size:20px; font-weight:700; letter-spacing:7px;
  color:#eaf9ff; text-shadow:0 0 14px rgba(52,230,255,.75);
}
.brand b { font-weight:700; }
.brand span { color:#34e6ff; }
.brand i {
  font-style:normal; font-size:10px; letter-spacing:3px; color:#5d7f97;
  margin-left:12px; vertical-align:middle; text-shadow:none;
}
#clockbox {
  position:absolute; left:50%; top:8px; width:340px; margin-left:-170px; text-align:center;
}
#clock {
  font-family:Consolas,"Lucida Console",monospace; font-size:24px; letter-spacing:4px;
  color:#34e6ff; text-shadow:0 0 16px rgba(52,230,255,.6); line-height:24px;
}
#cdate { font-size:10px; letter-spacing:3px; color:#6f8ba3; margin-top:3px; text-transform:uppercase; }
#winbtns { position:absolute; right:10px; top:10px; }
.wbtn {
  float:left; width:30px; height:28px; margin-left:6px; line-height:26px; text-align:center;
  border:1px solid rgba(52,230,255,.28); background:rgba(10,24,40,.6);
  color:#8fd8ec; font-family:Consolas,monospace; font-size:13px; cursor:pointer;
  transition:all .15s linear;
}
.wbtn:hover { border-color:#34e6ff; color:#04060c; background:#34e6ff; box-shadow:0 0 14px rgba(52,230,255,.7); }
.wbtn.cls:hover { border-color:#ff4b6e; background:#ff4b6e; box-shadow:0 0 14px rgba(255,75,110,.7); }

/* ---------- HUD Leiste ---------- */
#hud {
  position:absolute; left:0; top:50px; right:0; height:34px;
  border-bottom:1px solid rgba(52,230,255,.12);
  background:rgba(6,14,26,.45); padding:0 18px; overflow:hidden;
}
.hudcell { float:left; margin-right:26px; line-height:33px; font-size:11px; letter-spacing:1px; color:#5d7f97; text-transform:uppercase; }
.hudcell b { color:#34e6ff; font-family:Consolas,monospace; font-size:14px; letter-spacing:1px; margin-right:6px; }
.hudcell.warn b { color:#ffb038; }
.hudcell.bad  b { color:#ff4b6e; }
#hudpath { float:right; line-height:33px; font-size:10px; color:#3f5a6e; letter-spacing:1px; max-width:46%; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }

/* ---------- Spalten ---------- */
#main { position:absolute; left:0; top:84px; right:0; bottom:30px; }
.col { position:absolute; top:0; bottom:0; padding:12px 7px; }
#colL { left:0;   width:30%; padding-left:14px; }
#colM { left:30%; width:34%; }
#colR { left:64%; width:36%; padding-right:14px; }

/* ---------- Panels ---------- */
.panel {
  position:relative; height:100%;
  background:linear-gradient(160deg, rgba(11,22,38,.80) 0%, rgba(7,14,25,.72) 100%);
  border:1px solid rgba(52,230,255,.22);
  box-shadow:0 0 26px rgba(0,0,0,.55), inset 0 0 40px rgba(0,120,180,.07);
}
.panel:before, .panel:after { content:""; position:absolute; width:13px; height:13px; z-index:4; }
.panel:before { left:-1px;  top:-1px;    border-left:2px solid #34e6ff; border-top:2px solid #34e6ff; }
.panel:after  { right:-1px; bottom:-1px; border-right:2px solid #34e6ff; border-bottom:2px solid #34e6ff; }
.p-head {
  position:absolute; left:0; top:0; right:0; height:38px; padding:0 12px;
  border-bottom:1px solid rgba(52,230,255,.16);
  background:linear-gradient(180deg, rgba(52,230,255,.10) 0%, rgba(52,230,255,0) 100%);
}
.p-head h2 {
  float:left; font-size:12px; font-weight:600; letter-spacing:3px; line-height:37px;
  color:#34e6ff; text-transform:uppercase; text-shadow:0 0 10px rgba(52,230,255,.45);
}
.p-head .hint { float:right; line-height:37px; font-size:10px; letter-spacing:1px; color:#4a677d; text-transform:uppercase; }
.p-body { position:absolute; left:0; right:0; bottom:0; overflow:auto; overflow-x:hidden;
  scrollbar-base-color:#0a1420; scrollbar-face-color:#15314a; scrollbar-arrow-color:#34e6ff;
  scrollbar-track-color:#070e18; scrollbar-shadow-color:#070e18; scrollbar-highlight-color:#070e18;
  scrollbar-3dlight-color:#070e18; scrollbar-darkshadow-color:#070e18; }

/* ---------- Buttons / Inputs ---------- */
.btn {
  border:1px solid rgba(52,230,255,.30); background:rgba(10,26,42,.65); color:#8fd8ec;
  font-family:"Segoe UI",sans-serif; font-size:10px; letter-spacing:1.5px; text-transform:uppercase;
  padding:6px 10px; cursor:pointer; transition:all .15s linear;
}
.btn:hover { border-color:#34e6ff; color:#02121a; background:#34e6ff; box-shadow:0 0 12px rgba(52,230,255,.6); }
.btn.on { border-color:#34e6ff; color:#02121a; background:#34e6ff; }
.btn.ghost { background:transparent; }
.tinput {
  border:1px solid rgba(52,230,255,.25); background:rgba(3,10,18,.85); color:#dff4ff;
  font-family:"Segoe UI",sans-serif; font-size:13px; padding:7px 9px; outline:none;
}
.tinput:focus { border-color:#34e6ff; box-shadow:0 0 12px rgba(52,230,255,.35); }
.tinput::-ms-clear { display:none; }

/* ---------- Aufgaben ---------- */
#todoAdd { position:absolute; left:0; top:38px; right:0; height:48px; padding:8px 10px; }
#todoText { position:absolute; left:10px; right:96px; top:8px; height:32px; }
#todoBtn  { position:absolute; right:10px; top:8px; width:78px; height:32px; }
#todoBar  { position:absolute; left:0; top:86px; right:0; height:34px; padding:2px 10px; border-bottom:1px solid rgba(52,230,255,.10); }
#todoBar .btn { float:left; margin-right:5px; padding:5px 9px; }
#dayChip {
  float:right; margin-top:4px; font-size:10px; letter-spacing:1px; color:#02121a; background:#ffb038;
  padding:5px 8px; cursor:pointer; text-transform:uppercase; display:none;
}
#todoBody { top:120px; }

.item { position:relative; padding:10px 70px 10px 38px; border-bottom:1px solid rgba(52,230,255,.07); transition:background .12s linear; }
.item.todo { padding-right:90px; }
.item:hover { background:rgba(52,230,255,.055); }
.item .ttl { font-size:13px; color:#dcf1fb; line-height:17px; word-wrap:break-word; }
.item .meta { font-size:10px; color:#537289; letter-spacing:.6px; margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.item .iacts { position:absolute; right:8px; top:8px; }
.item .iacts .ib {
  float:left; width:18px; height:18px; line-height:16px; text-align:center; margin-left:2px;
  border:1px solid rgba(52,230,255,.0); background:transparent; color:#4d6b81;
  font-family:Consolas,monospace; font-size:12px; cursor:pointer; visibility:hidden;
}
.item:hover .iacts .ib { visibility:visible; }
.item .iacts .ib:hover { color:#34e6ff; border-color:rgba(52,230,255,.4); }
.item .iacts .ib.del:hover { color:#ff4b6e; border-color:rgba(255,75,110,.5); }
.item .iacts .ib.star.on { visibility:visible; color:#ffb038; }

.chk {
  position:absolute; left:12px; top:11px; width:16px; height:16px;
  border:1px solid rgba(52,230,255,.45); background:rgba(3,12,20,.7); cursor:pointer; transition:all .12s linear;
}
.chk:hover { border-color:#34e6ff; box-shadow:0 0 10px rgba(52,230,255,.55); }
.todo.done .chk { background:#34e6ff; border-color:#34e6ff; }
.todo.done .chk:after { content:"\2713"; position:absolute; left:2px; top:-3px; color:#02121a; font-size:13px; font-weight:bold; }
.todo.done .ttl { color:#4d6b81; text-decoration:line-through; }
.todo.prio .ttl { color:#ffe9c2; }
.todo.prio:before { content:""; position:absolute; left:0; top:0; bottom:0; width:2px; background:#ffb038; }

.due { display:inline-block; padding:1px 6px; border:1px solid rgba(52,230,255,.28); color:#7fc7dd; margin-right:6px; font-family:Consolas,monospace; }
.due.today { border-color:#34e6ff; color:#02121a; background:#34e6ff; }
.due.soon  { border-color:#ffb038; color:#ffb038; }
.due.over  { border-color:#ff4b6e; color:#02121a; background:#ff4b6e; }

.empty { padding:28px 16px; text-align:center; color:#3f5a6e; font-size:11px; letter-spacing:2px; text-transform:uppercase; }
.empty b { display:block; font-size:30px; color:#1d3448; margin-bottom:10px; font-weight:400; }

/* ---------- Kalender ---------- */
#calNav { position:absolute; left:0; top:38px; right:0; height:38px; padding:5px 10px; }
#calNav .btn { float:left; width:28px; padding:6px 0; text-align:center; }
#calTitle {
  float:left; width:52%; margin:0 6px; line-height:26px; text-align:center;
  font-size:12px; letter-spacing:3px; color:#dff4ff; text-transform:uppercase;
}
#calNav .btn.today { float:right; width:auto; padding:6px 9px; }
#calWd { position:absolute; left:0; top:76px; right:0; height:22px; padding:0 8px; }
#calWd div { float:left; width:14.28%; text-align:center; font-size:9px; letter-spacing:1.5px; color:#4a677d; text-transform:uppercase; line-height:20px; }
#calWrap { position:absolute; left:8px; right:8px; top:98px; bottom:8px; }
table.cal { width:100%; height:100%; border-collapse:collapse; table-layout:fixed; }
table.cal td {
  width:14.28%; height:16.6%; text-align:center; vertical-align:middle; position:relative;
  border:1px solid rgba(52,230,255,.07); color:#9fc3d6; font-family:Consolas,monospace; font-size:13px;
  cursor:pointer; transition:all .12s linear;
}
table.cal td:hover { background:rgba(52,230,255,.12); color:#eaf9ff; }
table.cal td.oth { color:#2b4459; }
table.cal td.we { color:#7e9bb0; }
table.cal td.oth.we { color:#26394b; }
table.cal td.today { border-color:#34e6ff; color:#02121a; background:#34e6ff; font-weight:bold; box-shadow:0 0 14px rgba(52,230,255,.5); }
table.cal td.sel { border:1px solid #ffb038; color:#ffd58a; background:rgba(255,176,56,.14); }
table.cal td.today.sel { color:#02121a; background:#ffb038; border-color:#ffb038; box-shadow:0 0 14px rgba(255,176,56,.5); }
table.cal td .dots { position:absolute; left:0; right:0; bottom:4px; height:5px; line-height:5px; }
table.cal td .dots i { display:inline-block; width:4px; height:4px; background:#ff4fd8; margin:0 1px; border-radius:2px; }
table.cal td.today .dots i { background:#02121a; }
table.cal td .dots i.od { background:#ff4b6e; }

/* ---------- Schnellzugriff ---------- */
#panFiles { position:absolute; left:7px; right:14px; top:12px; height:calc(56% - 18px); }
#panApps  { position:absolute; left:7px; right:14px; bottom:12px; height:calc(44% - 12px); }
.p-tools { position:absolute; left:0; top:38px; right:0; height:40px; padding:6px 8px; border-bottom:1px solid rgba(52,230,255,.10); }
.p-tools .btn { float:left; margin-right:4px; padding:6px 7px; letter-spacing:1px; }
.p-tools .srch { float:right; width:26%; min-width:64px; height:26px; padding:4px 7px; font-size:11px; }
.tbody { top:78px; }

.fic {
  position:absolute; left:9px; top:9px; width:24px; height:20px; line-height:19px; text-align:center;
  font-family:Consolas,monospace; font-size:8px; letter-spacing:.5px; font-weight:bold;
  color:#02121a; background:#34e6ff;
}
.fic.dir { background:#ffb038; }
.fic.web { background:#8b7dff; }
.fic.doc { background:#4fb3ff; }
.fic.img { background:#3ddc97; }
.fic.med { background:#ff4fd8; }
.fic.zip { background:#c0cad4; }
.item.miss .ttl { color:#ff8ea3; }
.item.miss .fic { background:#ff4b6e; }

.tile {
  float:left; width:50%; height:58px; position:relative; cursor:pointer;
}
.tinner {
  position:absolute; left:5px; right:5px; top:5px; bottom:5px; padding:0 8px 0 46px;
  border:1px solid rgba(52,230,255,.16); background:rgba(6,16,28,.6); transition:all .14s linear;
}
.tile:hover .tinner { border-color:#34e6ff; background:rgba(52,230,255,.14); box-shadow:0 0 16px rgba(52,230,255,.28); }
.tico {
  position:absolute; left:8px; top:9px; width:30px; height:30px; line-height:29px; text-align:center;
  font-size:15px; font-weight:bold; color:#02121a; background:#34e6ff;
  font-family:"Segoe UI",sans-serif;
}
.tile:nth-child(2n) .tico { background:#ff4fd8; }
.tname { font-size:12px; color:#dcf1fb; padding-top:12px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.tpath { font-size:9px; color:#4a677d; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.tdel {
  position:absolute; right:2px; top:1px; width:18px; height:18px; line-height:16px; text-align:center;
  background:transparent; border:0; color:#4d6b81; font-family:Consolas,monospace; font-size:11px;
  cursor:pointer; visibility:hidden;
}
.tile:hover .tdel { visibility:visible; }
.tdel:hover { color:#ff4b6e; }
.tile.miss .tico { background:#ff4b6e; }
.clr { clear:both; height:1px; }

/* ---------- Statusleiste ---------- */
#status {
  position:absolute; left:0; right:0; bottom:0; height:30px; padding:0 16px;
  border-top:1px solid rgba(52,230,255,.14); background:rgba(5,12,22,.75);
  font-size:10px; letter-spacing:1.5px; color:#44647a; line-height:29px; text-transform:uppercase;
}
#status .dot { display:inline-block; width:6px; height:6px; background:#3ddc97; margin-right:7px; vertical-align:middle; box-shadow:0 0 8px #3ddc97; }
#statusR { float:right; color:#2f4a5e; }
#grip { position:absolute; right:0; bottom:0; width:18px; height:18px; cursor:se-resize; z-index:9;
  background:linear-gradient(135deg, rgba(0,0,0,0) 55%, rgba(52,230,255,.55) 56%, rgba(0,0,0,0) 62%, rgba(0,0,0,0) 70%, rgba(52,230,255,.55) 71%, rgba(0,0,0,0) 78%); }

/* ---------- Dialog ---------- */
#ovl { position:absolute; left:0; top:0; right:0; bottom:0; z-index:40; background:rgba(2,6,12,.72); display:none; }
#dlg {
  position:absolute; left:50%; top:50%; width:460px; margin-left:-230px;
  transform:translateY(-50%); -ms-transform:translateY(-50%);
  background:linear-gradient(160deg, rgba(12,24,40,.98) 0%, rgba(7,14,25,.98) 100%);
  border:1px solid rgba(52,230,255,.4); box-shadow:0 0 50px rgba(0,0,0,.8), 0 0 24px rgba(52,230,255,.18);
}
#dlg:before, #dlg:after { content:""; position:absolute; width:14px; height:14px; }
#dlg:before { left:-1px; top:-1px; border-left:2px solid #34e6ff; border-top:2px solid #34e6ff; }
#dlg:after { right:-1px; bottom:-1px; border-right:2px solid #34e6ff; border-bottom:2px solid #34e6ff; }
#dlgTitle { padding:13px 16px; font-size:12px; letter-spacing:3px; color:#34e6ff; text-transform:uppercase; border-bottom:1px solid rgba(52,230,255,.16); }
#dlgBody { padding:16px; font-size:12px; color:#b6d6e6; line-height:19px; max-height:62vh; overflow:auto; overflow-x:hidden; }
#dlgBody .lbl { font-size:10px; letter-spacing:1.5px; color:#5d7f97; text-transform:uppercase; margin-bottom:6px; }
#dlgBody .tinput { width:100%; margin-bottom:12px; }
#dlgBody .mrow { padding:8px 12px; margin-bottom:4px; border:1px solid rgba(52,230,255,.16); background:rgba(6,16,28,.6); cursor:pointer; font-size:12px; color:#cfe9f5; }
#dlgBody .mrow:hover { border-color:#34e6ff; background:rgba(52,230,255,.14); color:#eaf9ff; }
#dlgBody .mrow small { display:block; color:#4a677d; font-size:10px; margin-top:2px; }
#dlgBody .note { font-size:11px; color:#5d7f97; word-wrap:break-word; }
#dlgBtns { padding:0 16px 16px 16px; text-align:right; }
#dlgBtns .btn { margin-left:6px; padding:8px 16px; }

/* ---------- Toast ---------- */
#toast {
  position:absolute; right:22px; bottom:44px; z-index:50; display:none; max-width:420px;
  padding:11px 16px; border:1px solid #34e6ff; background:rgba(6,20,32,.96);
  color:#dff4ff; font-size:12px; box-shadow:0 0 26px rgba(52,230,255,.35);
}

/* ---------- Boot ---------- */
#boot {
  position:absolute; left:0; top:0; right:0; bottom:0; z-index:90; background:#04060c;
  transition:opacity .45s linear;
}
#bootIn { position:absolute; left:50%; top:50%; width:400px; margin-left:-200px; margin-top:-60px; text-align:center; }
#bootIn .bt { font-size:26px; letter-spacing:12px; color:#eaf9ff; text-shadow:0 0 22px rgba(52,230,255,.8); }
#bootIn .bs { font-size:10px; letter-spacing:4px; color:#4a677d; margin-top:12px; text-transform:uppercase; }
#bootBar { height:2px; margin-top:20px; background:rgba(52,230,255,.15); position:relative; overflow:hidden; }
#bootBar i { position:absolute; left:0; top:0; bottom:0; width:0%; background:#34e6ff; box-shadow:0 0 12px #34e6ff; animation:boot 1.0s linear forwards; }
@keyframes boot { 0% { width:0%; } 100% { width:100%; } }

/* ============================================================
   THEME: MAGENTA
   ============================================================ */
.th-magenta .panel, .th-magenta #dlg { border-color:rgba(255,79,216,.24); }
.th-magenta .panel:before, .th-magenta .panel:after,
.th-magenta #dlg:before, .th-magenta #dlg:after { border-color:#ff4fd8; }
.th-magenta .brand span, .th-magenta #clock, .th-magenta .p-head h2,
.th-magenta .hudcell b, .th-magenta #dlgTitle { color:#ff4fd8; text-shadow:0 0 14px rgba(255,79,216,.6); }
.th-magenta .btn:hover, .th-magenta .btn.on, .th-magenta .wbtn:hover {
  border-color:#ff4fd8; background:#ff4fd8; color:#120214; box-shadow:0 0 14px rgba(255,79,216,.65); }
.th-magenta .fic, .th-magenta .tico, .th-magenta .due.today,
.th-magenta table.cal td.today { background:#ff4fd8; border-color:#ff4fd8; color:#120214; }
.th-magenta .tile:nth-child(2n) .tico { background:#34e6ff; }
.th-magenta .todo.done .chk { background:#ff4fd8; border-color:#ff4fd8; }
.th-magenta .tile:hover .tinner, .th-magenta table.cal td:hover { background:rgba(255,79,216,.14); border-color:#ff4fd8; }
.th-magenta #scan { background:linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(255,79,216,.16) 50%, rgba(0,0,0,0) 100%); }
.th-magenta #bootBar i { background-color:#ff4fd8; box-shadow:0 0 12px #ff4fd8; }

/* ============================================================
   THEME: AMBER
   ============================================================ */
.th-amber .panel, .th-amber #dlg { border-color:rgba(255,176,56,.26); }
.th-amber .panel:before, .th-amber .panel:after,
.th-amber #dlg:before, .th-amber #dlg:after { border-color:#ffb038; }
.th-amber .brand span, .th-amber #clock, .th-amber .p-head h2,
.th-amber .hudcell b, .th-amber #dlgTitle { color:#ffb038; text-shadow:0 0 14px rgba(255,176,56,.55); }
.th-amber .btn:hover, .th-amber .btn.on, .th-amber .wbtn:hover {
  border-color:#ffb038; background:#ffb038; color:#1a1002; box-shadow:0 0 14px rgba(255,176,56,.6); }
.th-amber .fic, .th-amber .tico, .th-amber .due.today,
.th-amber table.cal td.today { background:#ffb038; border-color:#ffb038; color:#1a1002; }
.th-amber .tile:nth-child(2n) .tico { background:#ff6a3d; }
.th-amber .todo.done .chk { background:#ffb038; border-color:#ffb038; }
.th-amber .tile:hover .tinner, .th-amber table.cal td:hover { background:rgba(255,176,56,.14); border-color:#ffb038; }
.th-amber #scan { background:linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(255,176,56,.16) 50%, rgba(0,0,0,0) 100%); }
.th-amber #bootBar i { background-color:#ffb038; }
</style>
</head>

<body>
<div id="bg"></div>
<div id="grid"></div>
<div id="vign"></div>
<div id="scan"></div>

<div id="app">

  <!-- ===== Titelleiste ===== -->
  <div id="titlebar">
    <div class="brand"><b>NOVA</b><span>DECK</span><i>Control Center</i></div>
    <div id="clockbox">
      <div id="clock">--:--:--</div>
      <div id="cdate">&nbsp;</div>
    </div>
    <div id="winbtns">
      <div class="wbtn" id="btnTheme" title="Design wechseln">&#9673;</div>
      <div class="wbtn" id="btnMenu"  title="Men&uuml;">&#9776;</div>
      <div class="wbtn" id="btnMax"   title="Maximieren / Wiederherstellen">&#9633;</div>
      <div class="wbtn cls" id="btnClose" title="Schlie&szlig;en">&#10005;</div>
    </div>
  </div>

  <!-- ===== HUD ===== -->
  <div id="hud">
    <div class="hudcell"><b id="hOpen">0</b>offen</div>
    <div class="hudcell warn"><b id="hToday">0</b>heute f&auml;llig</div>
    <div class="hudcell bad"><b id="hOver">0</b>&uuml;berf&auml;llig</div>
    <div class="hudcell"><b id="hDone">0</b>erledigt</div>
    <div class="hudcell"><b id="hLinks">0</b>verkn&uuml;pfungen</div>
    <div id="hudpath">&nbsp;</div>
  </div>

  <!-- ===== Spalten ===== -->
  <div id="main">

    <!-- Aufgaben -->
    <div class="col" id="colL">
      <div class="panel">
        <div class="p-head"><h2>Aufgaben</h2><div class="hint">Enter = anlegen</div></div>
        <div id="todoAdd">
          <input type="text" id="todoText" class="tinput" maxlength="300" autocomplete="off" placeholder="Neue Aufgabe ...">
          <button type="button" class="btn" id="todoBtn">+ ADD</button>
        </div>
        <div id="todoBar">
          <button type="button" class="btn on" id="fOpen">Offen</button>
          <button type="button" class="btn" id="fAll">Alle</button>
          <button type="button" class="btn" id="fDone">Erledigt</button>
          <div id="dayChip">&nbsp;</div>
        </div>
        <div class="p-body" id="todoBody"></div>
      </div>
    </div>

    <!-- Kalender -->
    <div class="col" id="colM">
      <div class="panel">
        <div class="p-head"><h2>Kalender</h2><div class="hint">Tag w&auml;hlen = Termin</div></div>
        <div id="calNav">
          <button type="button" class="btn" id="calPrev">&#9664;</button>
          <div id="calTitle">&nbsp;</div>
          <button type="button" class="btn" id="calNext">&#9654;</button>
          <button type="button" class="btn today" id="calToday">Heute</button>
        </div>
        <div id="calWd"><div>Mo</div><div>Di</div><div>Mi</div><div>Do</div><div>Fr</div><div>Sa</div><div>So</div></div>
        <div id="calWrap"><table class="cal" id="calTable"><tbody></tbody></table></div>
      </div>
    </div>

    <!-- Schnellzugriff -->
    <div class="col" id="colR">

      <div class="panel" id="panFiles">
        <div class="p-head"><h2>Dateien</h2><div class="hint">Doppelklick = &ouml;ffnen</div></div>
        <div class="p-tools">
          <button type="button" class="btn" id="addFile">+ Datei</button>
          <button type="button" class="btn" id="addFolder">+ Ordner</button>
          <button type="button" class="btn" id="addLink" title="Pfad oder Internet-Adresse von Hand eingeben">+ Pfad</button>
          <input type="text" class="tinput srch" id="fileSearch" autocomplete="off" placeholder="Suchen ...">
        </div>
        <div class="p-body tbody" id="fileBody"></div>
      </div>

      <div class="panel" id="panApps">
        <div class="p-head"><h2>Programme</h2><div class="hint">Doppelklick = starten</div></div>
        <div class="p-tools">
          <button type="button" class="btn" id="addApp">+ Programm</button>
          <button type="button" class="btn" id="addAppPath">Pfad ...</button>
          <input type="text" class="tinput srch" id="appSearch" autocomplete="off" placeholder="Suchen ...">
        </div>
        <div class="p-body tbody" id="appBody"></div>
      </div>

    </div>
  </div>

  <!-- ===== Statusleiste ===== -->
  <div id="status">
    <span class="dot"></span><span id="statusL">System bereit</span>
    <span id="statusR">NOVA DECK v1.0</span>
  </div>
  <div id="grip" title="Gr&ouml;&szlig;e &auml;ndern"></div>
</div>

<!-- Dialog -->
<div id="ovl">
  <div id="dlg">
    <div id="dlgTitle">Titel</div>
    <div id="dlgBody"></div>
    <div id="dlgBtns">
      <button type="button" class="btn ghost" id="dlgCancel">Abbrechen</button>
      <button type="button" class="btn" id="dlgOk">OK</button>
    </div>
  </div>
</div>

<div id="toast"></div>

<!-- Boot -->
<div id="boot"><div id="bootIn">
  <div class="bt">NOVA DECK</div>
  <div class="bs">System wird initialisiert</div>
  <div id="bootBar"><i></i></div>
</div></div>

<!-- versteckter Datei-Dialog (liefert im HTA den vollen Pfad) -->
<input type="file" id="picker" style="position:absolute;left:-2000px;top:-2000px;width:10px;">

<script type="text/javascript">
/* ================================================================
   NOVA DECK  -  Logik  (ES5 / IE11-kompatibel, laeuft in mshta.exe)
   ================================================================ */

/* ---------- kleine Helfer ---------- */
function $(id){ return document.getElementById(id); }
function on(el, ev, fn){ if(el){ el.addEventListener(ev, fn, false); } }
function tgt(e){ e = e || window.event; return e.target || e.srcElement; }
function esc(s){
  return String(s === null || typeof s === "undefined" ? "" : s)
    .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}
function pad(n){ return n < 10 ? "0" + n : "" + n; }
function uid(){ return (new Date()).getTime().toString(36) + Math.floor(Math.random()*1679616).toString(36); }
function trim(s){ return String(s).replace(/^\s+|\s+$/g, ""); }

var MONTHS = ["Januar","Februar","M\u00e4rz","April","Mai","Juni","Juli","August","September","Oktober","November","Dezember"];
var WDAYS  = ["Sonntag","Montag","Dienstag","Mittwoch","Donnerstag","Freitag","Samstag"];

function isoOf(d){ return d.getFullYear() + "-" + pad(d.getMonth()+1) + "-" + pad(d.getDate()); }
function dateOf(s){ var p = String(s).split("-"); return new Date(parseInt(p[0],10), parseInt(p[1],10)-1, parseInt(p[2],10)); }
function todayIso(){ return isoOf(new Date()); }
function shiftIso(s, days){ var d = dateOf(s); d.setDate(d.getDate()+days); return isoOf(d); }
function fmtShort(s){ var d = dateOf(s); return pad(d.getDate()) + "." + pad(d.getMonth()+1) + "."; }

/* ---------- Windows-Schnittstellen ---------- */
var fso = null, wsh = null, shellApp = null;
try { fso      = new ActiveXObject("Scripting.FileSystemObject"); } catch(e){}
try { wsh      = new ActiveXObject("WScript.Shell"); } catch(e){}
try { shellApp = new ActiveXObject("Shell.Application"); } catch(e){}

function env(v){ try { return wsh.ExpandEnvironmentStrings(v); } catch(e){ return v; } }
function special(name, fallback){
  try { var p = wsh.SpecialFolders(name); if(p && p.length) return p; } catch(e){}
  return env(fallback);
}
function exists(p){
  if(!fso || !p) return false;
  try { return fso.FileExists(p) || fso.FolderExists(p); } catch(e){ return false; }
}
function isFolder(p){ try { return fso.FolderExists(p); } catch(e){ return false; } }
function baseName(p){
  var s = String(p).replace(/[\\\/]+$/, "");
  var i = Math.max(s.lastIndexOf("\\"), s.lastIndexOf("/"));
  return i >= 0 ? s.substring(i+1) : s;
}
function dirName(p){
  var s = String(p).replace(/[\\\/]+$/, "");
  var i = s.lastIndexOf("\\");
  return i > 0 ? s.substring(0, i) : s;
}
function extOf(p){
  var n = baseName(p), i = n.lastIndexOf(".");
  return i > 0 ? n.substring(i+1).toLowerCase() : "";
}
function isUrl(p){ return /^(https?:|mailto:|ms-[a-z]+:|shell:|ftp:)/i.test(String(p)); }

function selfPath(){
  var h = decodeURI(location.href).replace(/[?#].*$/, "");
  if(/^file:\/\/\//i.test(h))      h = h.replace(/^file:\/\/\//i, "");
  else if(/^file:\/\//i.test(h))   h = "\\\\" + h.replace(/^file:\/\//i, "");
  return h.replace(/\//g, "\\");
}

/* ---------- Datenhaltung ---------- */
var DATA_DIR  = env("%APPDATA%") + "\\NovaDeck";
var DATA_FILE = DATA_DIR + "\\novadeck.json";

var DB = { version:1, todos:[], files:[], apps:[], settings:{ theme:"cyan", win:null } };

function ensureDir(){
  if(!fso) return false;
  try { if(!fso.FolderExists(DATA_DIR)) fso.CreateFolder(DATA_DIR); return true; } catch(e){ return false; }
}
function loadDB(){
  if(!fso) return false;
  try {
    if(!fso.FileExists(DATA_FILE)) return false;
    var f = fso.OpenTextFile(DATA_FILE, 1, false, -1);
    var s = f.AtEndOfStream ? "" : f.ReadAll();
    f.Close();
    if(!trim(s)) return false;
    var o = JSON.parse(s);
    if(o && typeof o === "object"){
      DB.todos    = o.todos    || [];
      DB.files    = o.files    || [];
      DB.apps     = o.apps     || [];
      DB.settings = o.settings || DB.settings;
      if(!DB.settings.theme) DB.settings.theme = "cyan";
      return true;
    }
  } catch(e){ toast("Daten konnten nicht gelesen werden: " + e.message); }
  return false;
}
var saveTimer = null;
function save(){
  if(saveTimer){ window.clearTimeout(saveTimer); }
  saveTimer = window.setTimeout(saveNow, 250);
}
function saveNow(){
  saveTimer = null;
  if(!fso) return;
  try {
    ensureDir();
    if(fso.FileExists(DATA_FILE)){ try { fso.CopyFile(DATA_FILE, DATA_FILE + ".bak", true); } catch(e2){} }
    var f = fso.CreateTextFile(DATA_FILE, true, true);
    f.Write(JSON.stringify(DB));
    f.Close();
    setStatus("Gespeichert " + pad(new Date().getHours()) + ":" + pad(new Date().getMinutes()));
  } catch(e){ setStatus("Speichern fehlgeschlagen: " + e.message); }
}

/* ---------- Zustand ---------- */
var state = {
  filter: "open",      /* open | all | done */
  dayFilter: null,     /* ISO-Datum oder null */
  calY: 0, calM: 0,
  selDate: null,
  fileQ: "", appQ: "",
  maxed: false, restoreRect: null
};

/* ================================================================
   Dialoge / Toast
   ================================================================ */
var dlgCb = null, dlgMode = null;

function openDlg(title, bodyHtml, mode, cb, okLabel){
  dlgMode = mode; dlgCb = cb || null;
  $("dlgTitle").innerHTML = esc(title);
  $("dlgBody").innerHTML  = bodyHtml;
  $("dlgOk").innerHTML    = esc(okLabel || "OK");
  $("dlgOk").style.display = (mode === "menu" || mode === "info") ? "none" : "";
  $("dlgCancel").innerHTML = (mode === "menu" || mode === "info") ? "Schlie&szlig;en" : "Abbrechen";
  $("ovl").style.display  = "block";
  var inp = $("dlgInput");
  if(inp){ try { inp.focus(); inp.select(); } catch(e){} }
}
function closeDlg(){ $("ovl").style.display = "none"; dlgCb = null; dlgMode = null; }

function uiPrompt(title, label, value, cb, okLabel){
  openDlg(title,
    '<div class="lbl">' + esc(label) + '</div>' +
    '<input type="text" id="dlgInput" class="tinput" autocomplete="off" value="' + esc(value || "") + '">',
    "prompt", cb, okLabel || "Speichern");
}
function uiConfirm(title, msg, cb){
  openDlg(title, '<div class="note">' + esc(msg) + '</div>', "confirm", cb, "Ja, ausf&uuml;hren");
}
function uiInfo(title, html){ openDlg(title, html, "info", null); }

var menuActions = [];
function uiMenu(title, items){
  menuActions = items;
  var h = "", i;
  for(i = 0; i < items.length; i++){
    h += '<div class="mrow" data-mi="' + i + '">' + esc(items[i].label) +
         (items[i].sub ? '<small>' + esc(items[i].sub) + '</small>' : '') + '</div>';
  }
  openDlg(title, h, "menu", null);
}

var toastTimer = null;
function toast(msg){
  var t = $("toast");
  t.innerHTML = esc(msg);
  t.style.display = "block";
  if(toastTimer) window.clearTimeout(toastTimer);
  toastTimer = window.setTimeout(function(){ $("toast").style.display = "none"; }, 3600);
}
function setStatus(msg){ $("statusL").innerHTML = esc(msg); }

/* ================================================================
   Aufgaben
   ================================================================ */
function addTodo(text){
  text = trim(text);
  if(!text) return;
  DB.todos.push({
    id: uid(), text: text, done: false, prio: false,
    due: state.selDate || null, created: (new Date()).getTime()
  });
  save(); renderTodos(); renderCal(); renderHud();
  setStatus("Aufgabe angelegt");
}
function findTodo(id){
  for(var i = 0; i < DB.todos.length; i++){ if(DB.todos[i].id === id) return DB.todos[i]; }
  return null;
}
function todoCmp(a, b){
  if(a.done !== b.done) return a.done ? 1 : -1;
  if(!a.done && a.prio !== b.prio) return a.prio ? -1 : 1;
  var ad = a.due || "9999-99-99", bd = b.due || "9999-99-99";
  if(ad !== bd) return ad < bd ? -1 : 1;
  return (a.created || 0) - (b.created || 0);
}
function dueInfo(due){
  if(!due) return null;
  var t = todayIso();
  if(due < t)               return { cls:"over",  txt:"\u00dcBERF\u00c4LLIG " + fmtShort(due) };
  if(due === t)             return { cls:"today", txt:"HEUTE" };
  if(due === shiftIso(t,1)) return { cls:"soon",  txt:"MORGEN" };
  return { cls:"", txt: fmtShort(due) };
}
function renderTodos(){
  var list = [], i, t;
  for(i = 0; i < DB.todos.length; i++){
    t = DB.todos[i];
    if(state.filter === "open" && t.done) continue;
    if(state.filter === "done" && !t.done) continue;
    if(state.dayFilter && t.due !== state.dayFilter) continue;
    list.push(t);
  }
  list.sort(todoCmp);

  var h = "";
  if(!list.length){
    h = '<div class="empty"><b>&#10022;</b>' +
        (state.dayFilter ? "Keine Aufgaben an diesem Tag" :
         (state.filter === "done" ? "Noch nichts erledigt" : "Alles erledigt")) + '</div>';
  }
  for(i = 0; i < list.length; i++){
    t = list[i];
    var di = dueInfo(t.due);
    var meta = "";
    if(di) meta += '<span class="due ' + di.cls + '">' + di.txt + '</span>';
    if(t.done) meta += '<span>erledigt</span>';
    h += '<div class="item todo' + (t.done ? " done" : "") + (t.prio && !t.done ? " prio" : "") + '" data-id="' + t.id + '">' +
           '<div class="chk" data-act="toggle"></div>' +
           '<div class="itxt">' +
             '<div class="ttl">' + esc(t.text) + '</div>' +
             (meta ? '<div class="meta">' + meta + '</div>' : '') +
           '</div>' +
           '<div class="iacts">' +
             '<button type="button" class="ib star' + (t.prio ? " on" : "") + '" data-act="prio" title="Priorit\u00e4t">&#9733;</button>' +
             '<button type="button" class="ib" data-act="date" title="F\u00e4lligkeit setzen">&#9678;</button>' +
             '<button type="button" class="ib" data-act="edit" title="Bearbeiten">&#9998;</button>' +
             '<button type="button" class="ib del" data-act="del" title="L\u00f6schen">&#10005;</button>' +
           '</div>' +
         '</div>';
  }
  $("todoBody").innerHTML = h;

  $("fOpen").className = "btn" + (state.filter === "open" ? " on" : "");
  $("fAll").className  = "btn" + (state.filter === "all"  ? " on" : "");
  $("fDone").className = "btn" + (state.filter === "done" ? " on" : "");

  var chip = $("dayChip");
  if(state.dayFilter){
    chip.innerHTML = "nur " + fmtShort(state.dayFilter) + " &nbsp;&#10005;";
    chip.style.display = "block";
  } else { chip.style.display = "none"; }
}
function onTodoClick(e){
  var n = tgt(e), act = null, row = null;
  while(n && n !== $("todoBody")){
    if(!act && n.getAttribute && n.getAttribute("data-act")) act = n.getAttribute("data-act");
    if(n.getAttribute && n.getAttribute("data-id")){ row = n; break; }
    n = n.parentNode;
  }
  if(!row) return;
  var t = findTodo(row.getAttribute("data-id"));
  if(!t) return;

  if(act === "toggle"){
    t.done = !t.done;
    save(); renderTodos(); renderCal(); renderHud();
  } else if(act === "prio"){
    t.prio = !t.prio; save(); renderTodos();
  } else if(act === "del"){
    for(var i = 0; i < DB.todos.length; i++){
      if(DB.todos[i].id === t.id){ DB.todos.splice(i,1); break; }
    }
    save(); renderTodos(); renderCal(); renderHud();
    setStatus("Aufgabe gel\u00f6scht");
  } else if(act === "edit"){
    uiPrompt("Aufgabe bearbeiten", "Text", t.text, function(v){
      v = trim(v); if(v){ t.text = v; save(); renderTodos(); }
    });
  } else if(act === "date"){
    uiPrompt("F\u00e4lligkeit", "Datum als TT.MM.JJJJ  (leer = kein Datum)",
      t.due ? fmtShort(t.due) + dateOf(t.due).getFullYear() : "", function(v){
        v = trim(v);
        if(!v){ t.due = null; }
        else {
          var m = v.match(/^(\d{1,2})[.\/-](\d{1,2})[.\/-]?(\d{2,4})?$/);
          if(!m){ toast("Bitte im Format TT.MM.JJJJ eingeben"); return; }
          var y = m[3] ? parseInt(m[3],10) : (new Date()).getFullYear();
          if(y < 100) y += 2000;
          t.due = y + "-" + pad(parseInt(m[2],10)) + "-" + pad(parseInt(m[1],10));
        }
        save(); renderTodos(); renderCal(); renderHud();
      });
  }
}

/* ================================================================
   Kalender
   ================================================================ */
function todoCountFor(iso){
  var open = 0, over = 0, t = todayIso();
  for(var i = 0; i < DB.todos.length; i++){
    var x = DB.todos[i];
    if(x.done || x.due !== iso) continue;
    open++;
    if(iso < t) over++;
  }
  return { open:open, over:over };
}
function renderCal(){
  $("calTitle").innerHTML = esc(MONTHS[state.calM] + " " + state.calY);

  var first = new Date(state.calY, state.calM, 1);
  var offset = (first.getDay() + 6) % 7;          /* Montag = 0 */
  var start = new Date(state.calY, state.calM, 1 - offset);
  var tIso = todayIso(), h = "", i, k;

  for(i = 0; i < 6; i++){
    h += "<tr>";
    for(k = 0; k < 7; k++){
      var d = new Date(start.getFullYear(), start.getMonth(), start.getDate() + (i*7 + k));
      var iso = isoOf(d);
      var cls = [];
      if(d.getMonth() !== state.calM) cls.push("oth");
      if(k >= 5) cls.push("we");
      if(iso === tIso) cls.push("today");
      if(iso === state.selDate) cls.push("sel");
      var c = todoCountFor(iso), dots = "";
      if(c.open > 0){
        dots = '<span class="dots">';
        for(var z = 0; z < Math.min(c.open, 3); z++){
          dots += '<i' + (c.over > 0 ? ' class="od"' : '') + '></i>';
        }
        dots += '</span>';
      }
      h += '<td class="' + cls.join(" ") + '" data-date="' + iso + '" title="' +
           esc(WDAYS[d.getDay()] + ", " + pad(d.getDate()) + "." + pad(d.getMonth()+1) + "." + d.getFullYear() +
               (c.open ? "  \u2013  " + c.open + " offene Aufgabe(n)" : "")) + '">' +
           d.getDate() + dots + '</td>';
    }
    h += "</tr>";
  }
  $("calTable").getElementsByTagName("tbody")[0].innerHTML = h;
}
function onCalClick(e){
  var n = tgt(e);
  while(n && (!n.getAttribute || !n.getAttribute("data-date"))){ n = n.parentNode; }
  if(!n) return;
  var iso = n.getAttribute("data-date");
  if(state.selDate === iso){
    state.selDate = null; state.dayFilter = null;
  } else {
    state.selDate = iso; state.dayFilter = iso;
    if(state.filter === "done") state.filter = "all";
  }
  if(state.selDate){
    var d = dateOf(state.selDate);
    state.calY = d.getFullYear(); state.calM = d.getMonth();
    $("todoText").setAttribute("placeholder", "Aufgabe f\u00fcr " + fmtShort(state.selDate) + " ...");
    setStatus("Termin gew\u00e4hlt: " + WDAYS[d.getDay()] + ", " + fmtShort(state.selDate) + d.getFullYear());
  } else {
    $("todoText").setAttribute("placeholder", "Neue Aufgabe ...");
    setStatus("Auswahl aufgehoben");
  }
  renderCal(); renderTodos();
}

/* ================================================================
   Dateien / Programme
   ================================================================ */
function icoClass(p){
  if(isUrl(p)) return "web";
  if(isFolder(p)) return "dir";
  var e = extOf(p);
  if(e === "pdf" || e === "doc" || e === "docx" || e === "txt" || e === "rtf" || e === "odt") return "doc";
  if(e === "xls" || e === "xlsx" || e === "csv" || e === "ppt" || e === "pptx") return "doc";
  if(e === "png" || e === "jpg" || e === "jpeg" || e === "gif" || e === "bmp" || e === "svg" || e === "webp") return "img";
  if(e === "mp3" || e === "mp4" || e === "avi" || e === "mkv" || e === "wav" || e === "mov") return "med";
  if(e === "zip" || e === "rar" || e === "7z") return "zip";
  return "";
}
function icoText(p){
  if(isUrl(p)) return "WEB";
  if(isFolder(p)) return "DIR";
  var e = extOf(p);
  return e ? e.substring(0,3).toUpperCase() : "\u2022";
}
function findIn(arr, id){
  for(var i = 0; i < arr.length; i++){ if(arr[i].id === id) return arr[i]; }
  return null;
}
function removeFrom(arr, id){
  for(var i = 0; i < arr.length; i++){ if(arr[i].id === id){ arr.splice(i,1); return true; } }
  return false;
}
function renderFiles(){
  var q = state.fileQ.toLowerCase(), h = "", i;
  var shown = 0;
  for(i = 0; i < DB.files.length; i++){
    var f = DB.files[i];
    if(q && (f.name + " " + f.path).toLowerCase().indexOf(q) < 0) continue;
    shown++;
    var miss = (!isUrl(f.path) && !exists(f.path));
    h += '<div class="item file' + (miss ? " miss" : "") + '" data-id="' + f.id + '" title="' + esc(f.path) + '">' +
           '<div class="fic ' + icoClass(f.path) + '">' + esc(icoText(f.path)) + '</div>' +
           '<div class="itxt">' +
             '<div class="ttl">' + esc(f.name) + '</div>' +
             '<div class="meta">' + (miss ? "NICHT GEFUNDEN \u00b7 " : "") + esc(f.path) + '</div>' +
           '</div>' +
           '<div class="iacts">' +
             '<button type="button" class="ib" data-act="reveal" title="Im Explorer zeigen">&#9707;</button>' +
             '<button type="button" class="ib" data-act="edit" title="Umbenennen">&#9998;</button>' +
             '<button type="button" class="ib del" data-act="del" title="Entfernen">&#10005;</button>' +
           '</div>' +
         '</div>';
  }
  if(!shown){
    h = '<div class="empty"><b>&#9744;</b>' +
        (state.fileQ ? "Kein Treffer" : "Dateien &uuml;ber + Datei hinzuf&uuml;gen") + '</div>';
  }
  $("fileBody").innerHTML = h;
}
function renderApps(){
  var q = state.appQ.toLowerCase(), h = "", i, shown = 0;
  for(i = 0; i < DB.apps.length; i++){
    var a = DB.apps[i];
    if(q && (a.name + " " + a.path).toLowerCase().indexOf(q) < 0) continue;
    shown++;
    var miss = (!isUrl(a.path) && a.path.indexOf("\\") >= 0 && !exists(a.path));
    h += '<div class="tile' + (miss ? " miss" : "") + '" data-id="' + a.id + '" title="' + esc(a.path) + '">' +
           '<div class="tinner">' +
             '<div class="tico">' + esc(a.name.substring(0,1).toUpperCase()) + '</div>' +
             '<div class="tname">' + esc(a.name) + '</div>' +
             '<div class="tpath">' + (miss ? "nicht gefunden" : esc(baseName(a.path))) + '</div>' +
             '<button type="button" class="tdel" data-act="del" title="Entfernen">&#10005;</button>' +
           '</div>' +
         '</div>';
  }
  h += '<div class="clr"></div>';
  if(!shown){
    h = '<div class="empty"><b>&#9881;</b>' +
        (state.appQ ? "Kein Treffer" : "Programme &uuml;ber + Programm hinzuf&uuml;gen") + '</div>';
  }
  $("appBody").innerHTML = h;
}

/* ---------- oeffnen / starten ---------- */
function openPath(p, args){
  if(!p) return;
  try {
    if(isUrl(p)){ shellApp.ShellExecute(p); }
    else if(args && trim(args)){ wsh.Run('"' + p + '" ' + args, 1, false); }
    else if(shellApp){ shellApp.ShellExecute(p, "", "", "open", 1); }
    else { wsh.Run('"' + p + '"', 1, false); }
    setStatus("Gestartet: " + baseName(p));
  } catch(err){
    uiInfo("Start fehlgeschlagen",
      '<div class="note">' + esc(p) + '<br><br>' + esc(err.message) + '</div>');
  }
}
function revealPath(p){
  try {
    if(isUrl(p)){ shellApp.ShellExecute(p); return; }
    if(isFolder(p)) wsh.Run('explorer.exe "' + p + '"', 1, false);
    else            wsh.Run('explorer.exe /select,"' + p + '"', 1, false);
    setStatus("Im Explorer ge\u00f6ffnet");
  } catch(err){ toast("Explorer konnte nicht ge\u00f6ffnet werden"); }
}
function onFileClick(e){
  var n = tgt(e), act = null, row = null;
  while(n && n !== $("fileBody")){
    if(!act && n.getAttribute && n.getAttribute("data-act")) act = n.getAttribute("data-act");
    if(n.getAttribute && n.getAttribute("data-id")){ row = n; break; }
    n = n.parentNode;
  }
  if(!row) return;
  var f = findIn(DB.files, row.getAttribute("data-id"));
  if(!f) return;
  if(act === "del"){ removeFrom(DB.files, f.id); save(); renderFiles(); renderHud(); setStatus("Entfernt"); }
  else if(act === "reveal"){ revealPath(f.path); }
  else if(act === "edit"){
    uiPrompt("Umbenennen", "Anzeigename", f.name, function(v){
      v = trim(v); if(v){ f.name = v; save(); renderFiles(); }
    });
  }
}
function onFileDbl(e){
  var n = tgt(e);
  while(n && n !== $("fileBody") && (!n.getAttribute || !n.getAttribute("data-id"))){ n = n.parentNode; }
  if(!n || !n.getAttribute) return;
  var f = findIn(DB.files, n.getAttribute("data-id"));
  if(f) openPath(f.path, null);
}
function onAppClick(e){
  var n = tgt(e), act = null, row = null;
  while(n && n !== $("appBody")){
    if(!act && n.getAttribute && n.getAttribute("data-act")) act = n.getAttribute("data-act");
    if(n.getAttribute && n.getAttribute("data-id")){ row = n; break; }
    n = n.parentNode;
  }
  if(!row) return;
  var a = findIn(DB.apps, row.getAttribute("data-id"));
  if(!a) return;
  if(act === "del"){ removeFrom(DB.apps, a.id); save(); renderApps(); renderHud(); setStatus("Entfernt"); }
}
function onAppDbl(e){
  var n = tgt(e);
  while(n && n !== $("appBody") && (!n.getAttribute || !n.getAttribute("data-id"))){ n = n.parentNode; }
  if(!n || !n.getAttribute) return;
  var a = findIn(DB.apps, n.getAttribute("data-id"));
  if(a) openPath(a.path, a.args);
}

/* ---------- hinzufuegen ---------- */
function addFileEntry(path, name){
  path = trim(path);
  if(!path) return false;
  for(var i = 0; i < DB.files.length; i++){
    if(DB.files[i].path.toLowerCase() === path.toLowerCase()){ toast("Ist bereits vorhanden"); return false; }
  }
  DB.files.push({ id: uid(), name: name || baseName(path) || path, path: path });
  save(); renderFiles(); renderHud();
  return true;
}
function addAppEntry(path, name, args){
  path = trim(path);
  if(!path) return false;
  for(var i = 0; i < DB.apps.length; i++){
    if(DB.apps[i].path.toLowerCase() === path.toLowerCase()){ toast("Ist bereits vorhanden"); return false; }
  }
  var n = name;
  if(!n){
    n = baseName(path).replace(/\.(exe|lnk|bat|cmd|url)$/i, "");
    if(n.length) n = n.substring(0,1).toUpperCase() + n.substring(1);
  }
  DB.apps.push({ id: uid(), name: n || path, path: path, args: args || "" });
  save(); renderApps(); renderHud();
  return true;
}

/* Datei-Dialog: im HTA liefert input[type=file].value den vollen Pfad */
var pickerCb = null;
function pickFile(cb){
  var el = $("picker");
  if(!el){ return; }
  pickerCb = cb;
  try { el.value = ""; } catch(e){}
  try {
    el.click();                       /* oeffnet den Windows-Dialog (modal) */
  } catch(err){
    /* Dialog nicht verfuegbar -> Pfad von Hand eingeben */
    pickerCb = null;
    uiPrompt("Pfad eingeben", "Vollst\u00e4ndiger Pfad (z. B. C:\\Ordner\\Datei.pdf)", "",
      function(v){ if(trim(v)) cb(trim(v)); });
    return;
  }
  /* Der Dialog ist modal: der Wert steht direkt danach zur Verfuegung. */
  var v = trim(el.value);
  if(v){ var cb2 = pickerCb; pickerCb = null; cb2(v); return; }
  /* Abgebrochen (oder Wert kommt asynchron ueber onchange) */
  window.setTimeout(function(){ pickerCb = null; }, 2000);
}
function onPickerChange(){
  var v = trim($("picker").value);
  var cb = pickerCb; pickerCb = null;
  if(v && cb) cb(v);
}
function pickFolder(cb){
  try {
    var f = shellApp.BrowseForFolder(0, "Ordner f\u00fcr den Schnellzugriff w\u00e4hlen", 0);
    if(f){
      var p = null;
      try { p = f.Self.Path; } catch(e){ p = null; }
      if(p) { cb(p); return; }
    }
    return;
  } catch(err){
    uiPrompt("Ordner eingeben", "Vollst\u00e4ndiger Ordnerpfad", "", function(v){ if(trim(v)) cb(trim(v)); });
  }
}

/* ---------- Drag & Drop aus dem Explorer ---------- */
function dropPaths(e){
  e = e || window.event;
  var paths = [], dt = null, i;
  try { dt = e.dataTransfer || (window.event ? window.event.dataTransfer : null); } catch(x){}
  if(dt){
    try {
      if(dt.files && dt.files.length){
        for(i = 0; i < dt.files.length; i++){
          var p = dt.files[i].path || dt.files[i].name;
          if(p && p.indexOf("\\") >= 0) paths.push(p);
        }
      }
    } catch(x2){}
    if(!paths.length){
      try {
        var txt = dt.getData("Text");
        if(txt){
          var parts = txt.split(/\r?\n/);
          for(i = 0; i < parts.length; i++){
            var q = trim(parts[i]);
            if(q && (q.indexOf("\\") >= 0 || isUrl(q))) paths.push(q);
          }
        }
      } catch(x3){}
    }
  }
  if(e.preventDefault) e.preventDefault();
  e.returnValue = false;
  if(!paths.length){
    toast("Ablegen nicht m\u00f6glich \u2013 bitte die Buttons \u201e+ Datei\u201c / \u201e+ Programm\u201c nutzen.");
    return false;
  }
  var added = 0;
  for(i = 0; i < paths.length; i++){
    var pp = paths[i];
    if(/\.(exe|lnk|bat|cmd|com|msc)$/i.test(pp)){ if(addAppEntry(pp)) added++; }
    else if(isUrl(pp) || exists(pp)){ if(addFileEntry(pp)) added++; }
  }
  setStatus(added + " Eintrag/Eintr\u00e4ge hinzugef\u00fcgt");
  return false;
}

/* ================================================================
   HUD / Uhr
   ================================================================ */
function renderHud(){
  var open = 0, done = 0, today = 0, over = 0, t = todayIso();
  for(var i = 0; i < DB.todos.length; i++){
    var x = DB.todos[i];
    if(x.done){ done++; continue; }
    open++;
    if(x.due === t) today++;
    else if(x.due && x.due < t) over++;
  }
  $("hOpen").innerHTML  = open;
  $("hToday").innerHTML = today;
  $("hOver").innerHTML  = over;
  $("hDone").innerHTML  = done;
  $("hLinks").innerHTML = DB.files.length + DB.apps.length;
  $("hudpath").innerHTML = esc(DATA_FILE);
}
function tick(){
  var d = new Date();
  $("clock").innerHTML = pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":" + pad(d.getSeconds());
  $("cdate").innerHTML = esc(WDAYS[d.getDay()] + " \u00b7 " + pad(d.getDate()) + ". " + MONTHS[d.getMonth()] + " " + d.getFullYear());
}

/* ================================================================
   Fenster: verschieben, maximieren, Groesse
   ================================================================ */
var dragW = null, sizeW = null;

function onTitleDown(e){
  e = e || window.event;
  var t = tgt(e);
  if(t && t.className && String(t.className).indexOf("wbtn") >= 0) return;
  dragW = { sx: e.screenX, sy: e.screenY, wx: window.screenLeft, wy: window.screenTop };
  try { $("titlebar").setCapture(); } catch(x){}
  if(e.preventDefault) e.preventDefault();
  e.returnValue = false;
  return false;
}
function onGripDown(e){
  e = e || window.event;
  sizeW = { sx: e.screenX, sy: e.screenY, w: document.body.clientWidth, h: document.body.clientHeight };
  try { $("grip").setCapture(); } catch(x){}
  if(e.preventDefault) e.preventDefault();
  e.returnValue = false;
  return false;
}
function onDocMove(e){
  e = e || window.event;
  if(dragW){
    try { window.moveTo(dragW.wx + (e.screenX - dragW.sx), dragW.wy + (e.screenY - dragW.sy)); } catch(x){}
  } else if(sizeW){
    var w = Math.max(940, sizeW.w + (e.screenX - sizeW.sx));
    var h = Math.max(580, sizeW.h + (e.screenY - sizeW.sy));
    try { window.resizeTo(w, h); } catch(x2){}
  }
}
function onDocUp(){
  if(dragW || sizeW){
    dragW = null; sizeW = null;
    try { document.releaseCapture(); } catch(x){}
    rememberWin();
  }
}
function rememberWin(){
  try {
    DB.settings.win = { x: window.screenLeft, y: window.screenTop,
                        w: document.body.clientWidth, h: document.body.clientHeight, max: state.maxed };
    save();
  } catch(e){}
}
function toggleMax(){
  try {
    if(state.maxed && state.restoreRect){
      window.resizeTo(state.restoreRect.w, state.restoreRect.h);
      window.moveTo(state.restoreRect.x, state.restoreRect.y);
      state.maxed = false;
    } else {
      state.restoreRect = { x: window.screenLeft, y: window.screenTop,
                            w: document.body.clientWidth, h: document.body.clientHeight };
      window.moveTo(0, 0);
      window.resizeTo(screen.availWidth, screen.availHeight);
      state.maxed = true;
    }
    rememberWin();
  } catch(e){}
}
function initWindow(){
  var w = Math.min(1280, screen.availWidth  - 60);
  var h = Math.min(820,  screen.availHeight - 60);
  var x = Math.max(0, Math.floor((screen.availWidth  - w) / 2));
  var y = Math.max(0, Math.floor((screen.availHeight - h) / 2));
  var s = DB.settings.win;
  if(s && s.w > 600 && s.h > 400 && s.w <= screen.availWidth && s.h <= screen.availHeight){
    w = s.w; h = s.h;
    x = Math.min(Math.max(0, s.x), screen.availWidth  - 200);
    y = Math.min(Math.max(0, s.y), screen.availHeight - 200);
  }
  try { window.resizeTo(w, h); window.moveTo(x, y); } catch(e){}
}

/* ================================================================
   Theme / Menue
   ================================================================ */
function applyTheme(name){
  DB.settings.theme = name;
  document.documentElement.className = (name === "cyan" ? "" : "th-" + name);
}
function cycleTheme(){
  var order = ["cyan","magenta","amber"];
  var i = 0;
  for(var k = 0; k < order.length; k++){ if(order[k] === DB.settings.theme) i = k; }
  applyTheme(order[(i+1) % order.length]);
  save();
  setStatus("Design: " + DB.settings.theme.toUpperCase());
}

function startupDir(){ return env("%APPDATA%") + "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup"; }
function autostartLnk(){ return startupDir() + "\\NovaDeck.lnk"; }

function makeShortcut(fullLnkPath){
  var me = selfPath();
  var lnk = wsh.CreateShortcut(fullLnkPath);
  lnk.TargetPath = me;
  lnk.WorkingDirectory = dirName(me);
  lnk.Description = "NOVA DECK Control Center";
  try { lnk.IconLocation = env("%WINDIR%") + "\\system32\\shell32.dll, 13"; } catch(e){}
  lnk.Save();
}
function showMenu(){
  var autoOn = false;
  try { autoOn = fso.FileExists(autostartLnk()); } catch(e){}
  uiMenu("Men\u00fc", [
    { label:"Design wechseln", sub:"Aktuell: " + DB.settings.theme.toUpperCase(),
      fn: function(){ cycleTheme(); } },
    { label:"Verkn\u00fcpfung auf dem Desktop anlegen", sub:"Startet NOVA DECK per Doppelklick",
      fn: function(){
        try {
          makeShortcut(special("Desktop", "%USERPROFILE%\\Desktop") + "\\NOVA DECK.lnk");
          toast("Verkn\u00fcpfung auf dem Desktop angelegt");
        } catch(e){ toast("Fehlgeschlagen: " + e.message); }
      } },
    { label: autoOn ? "Autostart deaktivieren" : "Mit Windows starten",
      sub: autoOn ? "Verkn\u00fcpfung im Autostart entfernen" : "Verkn\u00fcpfung im Autostart anlegen",
      fn: function(){
        try {
          if(autoOn){ fso.DeleteFile(autostartLnk()); toast("Autostart deaktiviert"); }
          else { makeShortcut(autostartLnk()); toast("NOVA DECK startet ab jetzt mit Windows"); }
        } catch(e){ toast("Fehlgeschlagen: " + e.message); }
      } },
    { label:"Datenordner \u00f6ffnen", sub: DATA_DIR,
      fn: function(){ ensureDir(); revealPath(DATA_DIR); } },
    { label:"Erledigte Aufgaben l\u00f6schen", sub:"Entfernt alle abgehakten Eintr\u00e4ge",
      fn: function(){
        uiConfirm("Erledigte l\u00f6schen", "Alle erledigten Aufgaben endg\u00fcltig entfernen?", function(){
          var keep = [];
          for(var i = 0; i < DB.todos.length; i++){ if(!DB.todos[i].done) keep.push(DB.todos[i]); }
          var n = DB.todos.length - keep.length;
          DB.todos = keep; save(); renderTodos(); renderCal(); renderHud();
          toast(n + " Aufgabe(n) gel\u00f6scht");
        });
      } },
    { label:"Standard-Programme erneut suchen", sub:"F\u00fcgt gefundene Programme hinzu",
      fn: function(){ var n = seedApps(true); renderApps(); renderHud(); save(); toast(n + " Programm(e) hinzugef\u00fcgt"); } },
    { label:"\u00dcber NOVA DECK", sub:"Version 1.0",
      fn: function(){
        uiInfo("\u00dcber NOVA DECK",
          '<div class="note"><b>NOVA DECK 1.0</b><br><br>' +
          'Einzeldatei-Cockpit f\u00fcr Windows (HTML Application).<br><br>' +
          'Datei: ' + esc(selfPath()) + '<br>' +
          'Daten: ' + esc(DATA_FILE) + '<br><br>' +
          'Tastatur: <b>Strg+N</b> neue Aufgabe &nbsp;\u00b7&nbsp; <b>Strg+F</b> Suche &nbsp;\u00b7&nbsp; ' +
          '<b>F5</b> neu laden &nbsp;\u00b7&nbsp; <b>Esc</b> Dialog schlie\u00dfen</div>');
      } }
  ]);
}

/* ================================================================
   Erstbefuellung
   ================================================================ */
function seedApps(silent){
  var cands = [
    ["Explorer",             "explorer.exe", true],
    ["Editor",               "%WINDIR%\\system32\\notepad.exe", false],
    ["Rechner",              "%WINDIR%\\system32\\calc.exe", false],
    ["Terminal",             "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\wt.exe", false],
    ["Eingabeaufforderung",  "%WINDIR%\\system32\\cmd.exe", false],
    ["Task-Manager",         "%WINDIR%\\system32\\Taskmgr.exe", false],
    ["Einstellungen",        "ms-settings:", true],
    ["Microsoft Edge",       "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe", false],
    ["Microsoft Edge",       "%ProgramFiles%\\Microsoft\\Edge\\Application\\msedge.exe", false],
    ["Google Chrome",        "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe", false],
    ["Google Chrome",        "%ProgramFiles(x86)%\\Google\\Chrome\\Application\\chrome.exe", false],
    ["Firefox",              "%ProgramFiles%\\Mozilla Firefox\\firefox.exe", false],
    ["Outlook",              "%ProgramFiles%\\Microsoft Office\\root\\Office16\\OUTLOOK.EXE", false],
    ["Word",                 "%ProgramFiles%\\Microsoft Office\\root\\Office16\\WINWORD.EXE", false],
    ["Excel",                "%ProgramFiles%\\Microsoft Office\\root\\Office16\\EXCEL.EXE", false],
    ["VS Code",              "%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe", false],
    ["Spotify",              "%APPDATA%\\Spotify\\Spotify.exe", false],
    ["Paint",                "%WINDIR%\\system32\\mspaint.exe", false]
  ];
  var added = 0, i, k;
  for(i = 0; i < cands.length; i++){
    var name = cands[i][0], p = env(cands[i][1]), always = cands[i][2];
    if(!always && !exists(p)) continue;
    var dup = false;
    for(k = 0; k < DB.apps.length; k++){
      if(DB.apps[k].name === name || DB.apps[k].path.toLowerCase() === p.toLowerCase()){ dup = true; break; }
    }
    if(dup) continue;
    DB.apps.push({ id: uid(), name: name, path: p, args: "" });
    added++;
  }
  return added;
}
function seedFiles(){
  var cands = [
    ["Desktop",    special("Desktop", "%USERPROFILE%\\Desktop")],
    ["Dokumente",  special("MyDocuments", "%USERPROFILE%\\Documents")],
    ["Downloads",  env("%USERPROFILE%\\Downloads")],
    ["Bilder",     env("%USERPROFILE%\\Pictures")]
  ];
  for(var i = 0; i < cands.length; i++){
    if(!isFolder(cands[i][1])) continue;
    DB.files.push({ id: uid(), name: cands[i][0], path: cands[i][1] });
  }
}
function seedTodos(){
  var t = todayIso();
  DB.todos.push({ id:uid(), text:"Willkommen! Aufgaben oben eintippen und mit Enter anlegen.", done:false, prio:true,  due:t,               created:1 });
  DB.todos.push({ id:uid(), text:"Tag im Kalender anklicken \u2013 neue Aufgaben bekommen dieses Datum.", done:false, prio:false, due:shiftIso(t,1), created:2 });
  DB.todos.push({ id:uid(), text:"Dateien und Programme rechts per Doppelklick \u00f6ffnen.", done:false, prio:false, due:null, created:3 });
}

/* ================================================================
   Start
   ================================================================ */
function boot(){
  var fresh = !loadDB();
  if(fresh){
    seedFiles(); seedApps(false); seedTodos();
    ensureDir(); saveNow();
  }
  applyTheme(DB.settings.theme || "cyan");
  initWindow();

  var now = new Date();
  state.calY = now.getFullYear();
  state.calM = now.getMonth();

  tick(); window.setInterval(tick, 1000);
  renderTodos(); renderCal(); renderFiles(); renderApps(); renderHud();

  if(!fso || !wsh || !shellApp){
    setStatus("Eingeschr\u00e4nkter Modus \u2013 Systemzugriff nicht verf\u00fcgbar");
    toast("Hinweis: Diese Datei muss als .hta gestartet werden (Doppelklick), nicht im Browser.");
  } else {
    setStatus("System bereit");
  }

  window.setTimeout(function(){
    var b = $("boot");
    b.style.opacity = "0";
    window.setTimeout(function(){ b.style.display = "none"; try { $("todoText").focus(); } catch(e){} }, 470);
  }, 1050);
}

/* ---------- Ereignisse ---------- */
function wire(){
  /* Fenster */
  on($("titlebar"), "mousedown", onTitleDown);
  on($("grip"), "mousedown", onGripDown);
  on(document, "mousemove", onDocMove);
  on(document, "mouseup", onDocUp);
  on($("btnClose"), "click", function(){ saveNow(); window.close(); });
  on($("btnMax"), "click", toggleMax);
  on($("btnTheme"), "click", cycleTheme);
  on($("btnMenu"), "click", showMenu);
  on($("titlebar"), "dblclick", function(e){
    var t = tgt(e);
    if(t && t.className && String(t.className).indexOf("wbtn") >= 0) return;
    toggleMax();
  });

  /* Aufgaben */
  on($("todoBtn"), "click", function(){ addTodo($("todoText").value); $("todoText").value = ""; $("todoText").focus(); });
  on($("todoText"), "keydown", function(e){
    e = e || window.event;
    if(e.keyCode === 13){ addTodo($("todoText").value); $("todoText").value = ""; }
  });
  on($("todoBody"), "click", onTodoClick);
  on($("fOpen"), "click", function(){ state.filter = "open"; renderTodos(); });
  on($("fAll"),  "click", function(){ state.filter = "all";  renderTodos(); });
  on($("fDone"), "click", function(){ state.filter = "done"; renderTodos(); });
  on($("dayChip"), "click", function(){
    state.dayFilter = null; state.selDate = null;
    $("todoText").setAttribute("placeholder", "Neue Aufgabe ...");
    renderTodos(); renderCal();
  });

  /* Kalender */
  on($("calTable"), "click", onCalClick);
  on($("calPrev"), "click", function(){
    state.calM--; if(state.calM < 0){ state.calM = 11; state.calY--; } renderCal();
  });
  on($("calNext"), "click", function(){
    state.calM++; if(state.calM > 11){ state.calM = 0; state.calY++; } renderCal();
  });
  on($("calToday"), "click", function(){
    var d = new Date(); state.calY = d.getFullYear(); state.calM = d.getMonth();
    state.selDate = todayIso(); state.dayFilter = todayIso();
    if(state.filter === "done") state.filter = "all";
    $("todoText").setAttribute("placeholder", "Aufgabe f\u00fcr heute ...");
    renderCal(); renderTodos();
  });

  /* Dateien */
  on($("fileBody"), "click", onFileClick);
  on($("fileBody"), "dblclick", onFileDbl);
  on($("picker"), "change", onPickerChange);
  on($("addFile"), "click", function(){
    pickFile(function(p){ if(addFileEntry(p)) setStatus("Datei hinzugef\u00fcgt: " + baseName(p)); });
  });
  on($("addFolder"), "click", function(){
    pickFolder(function(p){ if(addFileEntry(p)) setStatus("Ordner hinzugef\u00fcgt: " + baseName(p)); });
  });
  on($("addLink"), "click", function(){
    uiPrompt("Pfad oder Link hinzuf\u00fcgen",
      "Pfad (C:\\Ordner\\Datei.pdf) oder Adresse (https://...)", "", function(v){
      v = trim(v); if(!v) return;
      var vorschlag = isUrl(v)
        ? v.replace(/^[a-z]+:\/\//i, "").replace(/\/.*$/, "")
        : baseName(v);
      uiPrompt("Pfad oder Link hinzuf\u00fcgen", "Anzeigename", vorschlag, function(n){
        addFileEntry(v, trim(n) || v);
      });
    });
  });
  on($("fileSearch"), "keyup", function(){ state.fileQ = trim($("fileSearch").value); renderFiles(); });

  /* Programme */
  on($("appBody"), "click", onAppClick);
  on($("appBody"), "dblclick", onAppDbl);
  on($("addApp"), "click", function(){
    pickFile(function(p){ if(addAppEntry(p)) setStatus("Programm hinzugef\u00fcgt: " + baseName(p)); });
  });
  on($("addAppPath"), "click", function(){
    uiPrompt("Programm per Pfad", "Pfad oder Befehl (z. B. C:\\...\\app.exe oder notepad.exe)", "", function(v){
      v = trim(v); if(!v) return;
      uiPrompt("Programm per Pfad", "Anzeigename", baseName(v).replace(/\.(exe|lnk|bat|cmd)$/i,""), function(n){
        addAppEntry(v, trim(n) || null);
      });
    });
  });
  on($("appSearch"), "keyup", function(){ state.appQ = trim($("appSearch").value); renderApps(); });

  /* Dialog */
  on($("dlgCancel"), "click", closeDlg);
  on($("dlgOk"), "click", dlgOk);
  on($("dlgBody"), "click", function(e){
    var n = tgt(e);
    while(n && (!n.getAttribute || n.getAttribute("data-mi") === null)){ n = n.parentNode; }
    if(!n || !n.getAttribute) return;
    var idx = parseInt(n.getAttribute("data-mi"), 10);
    var it = menuActions[idx];
    closeDlg();
    if(it && it.fn) it.fn();
  });
  on($("ovl"), "mousedown", function(e){ if(tgt(e) === $("ovl")) closeDlg(); });

  /* Tastatur */
  on(document, "keydown", function(e){
    e = e || window.event;
    var open = ($("ovl").style.display === "block");
    if(open){
      if(e.keyCode === 27){ closeDlg(); return; }
      if(e.keyCode === 13 && dlgMode !== "menu" && dlgMode !== "info"){ dlgOk(); return; }
      return;
    }
    if(e.ctrlKey && e.keyCode === 78){
      try { $("todoText").focus(); } catch(x){}
      if(e.preventDefault) e.preventDefault();
      e.returnValue = false;
    }
    if(e.ctrlKey && e.keyCode === 70){
      try { $("fileSearch").focus(); $("fileSearch").select(); } catch(x){}
      if(e.preventDefault) e.preventDefault();
      e.returnValue = false;
    }
    if(e.keyCode === 27){ state.dayFilter = null; state.selDate = null; renderCal(); renderTodos(); }
  });

  /* Drag & Drop */
  on(document.body, "dragover", function(e){
    e = e || window.event;
    if(e.preventDefault) e.preventDefault();
    e.returnValue = false; return false;
  });
  on(document.body, "drop", dropPaths);

  /* Kontextmenue nur in Eingabefeldern */
  document.oncontextmenu = function(){
    var t = window.event ? window.event.srcElement : null;
    return !!(t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA"));
  };

  window.onunload = function(){ try { saveNow(); } catch(e){} };
}
function dlgOk(){
  var cb = dlgCb, mode = dlgMode, val = null;
  var inp = $("dlgInput");
  if(inp) val = inp.value;
  if(mode === "prompt"){
    /* Dialog bleibt offen, wenn der Callback eine Nachbesserung verlangt */
    closeDlg();
    if(cb) cb(val);
  } else if(mode === "confirm"){
    closeDlg();
    if(cb) cb(true);
  } else {
    closeDlg();
  }
}

/* los geht's */
window.onload = function(){ wire(); boot(); };
</script>
</body>
</html>
